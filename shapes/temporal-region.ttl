##### Temporal region: required content, target types, and linked-instance quality

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix nfdi:  <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix mwo:   <http://purls.helmholtz-metadaten.de/mwo/> .
@prefix pmd:   <https://w3id.org/pmd/co/> .
@prefix ex:    <https://nfdi.fiz-karlsruhe.de/matwerk/shapes/> .

ex:TemporalRegionShape
    a sh:NodeShape ;
    sh:targetClass obo:BFO_0000038 ;       # one-dimensional temporal region
    rdfs:label "Temporal region: required content and linked-instance quality" ;
    sh:or (
        [ sh:property [ sh:path obo:IAO_0000235 ;   # denoted by some text
                        sh:minCount 1 ] ]
        [ sh:property [ sh:path obo:BFO_0000222 ;   # has a first instant
                        sh:minCount 1 ] ]
        [ sh:property [ sh:path obo:BFO_0000224 ;   # has a last instant
                        sh:minCount 1 ] ]
    ) ;
    sh:message "Temporal region carries none of the alternatives above." ;
    .
