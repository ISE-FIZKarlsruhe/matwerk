##### Organization: required content, target types, and linked-instance quality

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix nfdi:  <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix mwo:   <http://purls.helmholtz-metadaten.de/mwo/> .
@prefix pmd:   <https://w3id.org/pmd/co/> .
@prefix ex:    <https://nfdi.fiz-karlsruhe.de/matwerk/shapes/> .


# A value node exists to hold a literal.
ex:NonEmptyValueNode
    a sh:NodeShape ;
    rdfs:label "value node carries a literal" ;
    sh:or (
        [ sh:property [ sh:path nfdi:NFDI_0001007 ;     # has value
                        sh:minCount 1 ] ]
        [ sh:property [ sh:path nfdi:NFDI_0001008 ;     # has url
                        sh:minCount 1 ] ]
        [ sh:property [ sh:path pmd:PMD_0000006 ;       # has value (PMDco)
                        sh:minCount 1 ] ]
        [ sh:property [ sh:path obo:OBI_0002135 ;    # has specified value
                        sh:minCount 1 ] ]
        [ sh:property [ sh:path rdfs:label ;            # a label alone is enough:
                        sh:minCount 1 ] ]               # value nodes reached by denoted-by
                                                        # carry their text as the label
    ) ;
    sh:message "Empty value node: no literal attached (has value / has url / PMDco has value / has specified value)." ;
    .

ex:OrganizationShape
    a sh:NodeShape ;
    sh:targetClass obo:OBI_0000245 ;       # organization
    rdfs:label "Organization: required content and linked-instance quality" ;
    sh:property [
        sh:path obo:IAO_0000235 ;       # denoted by
        sh:minCount 1 ;
        sh:message "an organization must be denoted by its institution name" ;
    ] ;
    sh:property [
        sh:path obo:RO_0001025 ;        # located in
        sh:message "located-in points at a city or a country" ;
    ] ;
    sh:property [
        sh:path obo:IAO_0000235 ;       # denoted by
        sh:node ex:NonEmptyValueNode ;
        sh:message "name / zip / website / ROR nodes must carry a value" ;
    ] ;
    .
