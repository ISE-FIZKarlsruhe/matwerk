##### Agent: required content, target types, and linked-instance quality

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix nfdi:  <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix mwo:   <http://purls.helmholtz-metadaten.de/mwo/> .
@prefix pmd:   <https://w3id.org/pmd/co/> .
@prefix ex:    <https://nfdi.fiz-karlsruhe.de/matwerk/shapes/> .

ex:AgentShape
    a sh:NodeShape ;
    sh:targetClass nfdi:NFDI_0000102 ;     # agent
    rdfs:label "Agent: required content and linked-instance quality" ;
    sh:or (
        [ sh:property [ sh:path obo:IAO_0000235 ;   # denoted by a written name
                        sh:minCount 1 ] ]
        [ sh:property [ sh:path [ sh:inversePath obo:RO_0000081 ] ;   # is the bearer of some role
                        sh:minCount 1 ] ]
    ) ;
    sh:message "Agent carries none of the alternatives above." ;
    .
