##### Material identifier: required content, target types, and linked-instance quality

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix nfdi:  <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix mwo:   <http://purls.helmholtz-metadaten.de/mwo/> .
@prefix pmd:   <https://w3id.org/pmd/co/> .
@prefix ex:    <https://nfdi.fiz-karlsruhe.de/matwerk/shapes/> .

ex:MaterialShape
    a sh:NodeShape ;
    sh:targetClass mwo:MWO_0001099 ;       # material identifier
    rdfs:label "Material identifier: required content and linked-instance quality" ;
    sh:property [
        sh:path nfdi:NFDI_0001007 ;     # has value
        sh:minCount 1 ;
        sh:message "a material identifier must carry its value" ;
    ] ;
    .
