##### A deprecated term must not be used where the ontology states its successor

PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>

SELECT DISTINCT ?term ?usedAs ?replacement WHERE {

  {
    # used as a class: something is an instance of it
    ?s rdf:type ?term .
    BIND("class" AS ?usedAs)
  }
  UNION
  {
    # used as a predicate
    ?s ?term ?o .
    BIND("property" AS ?usedAs)
  }

  FILTER(isIRI(?term))
  FILTER(!STRSTARTS(STR(?term), STR(owl:)))
  FILTER(!STRSTARTS(STR(?term), STR(rdf:)))
  FILTER(!STRSTARTS(STR(?term), STR(rdfs:)))

  # The reference ontologies are the authority on what is deprecated and on what
  # replaces it. ?replacement is bound, not OPTIONAL — that is what limits this
  # check to deprecations the ontology has already decided.
  SERVICE <http://matwerk-virtuoso:8890/sparql> {
    {
      GRAPH <https://nfdi.fiz-karlsruhe.de/matwerk/mwo/3.0.2> {
        { ?term owl:deprecated true } UNION { ?term a owl:DeprecatedClass }
        ?term obo:IAO_0100001 ?replacement .
      }
    }
    UNION
    {
      GRAPH <https://nfdi.fiz-karlsruhe.de/ontology/nfdicore-extension/3.0.5> {
        { ?term owl:deprecated true } UNION { ?term a owl:DeprecatedClass }
        ?term obo:IAO_0100001 ?replacement .
      }
    }
  }
}
