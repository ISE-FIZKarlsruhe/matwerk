ns4:NFDI_0000100 a owl:Class ;
    rdfs:label "academic discipline",
        "academic discipline"@en ;
    rdfs:comment "An information content entity that specifies the subject area, domain or academic discipline of an entity. An academic discipline, a research field or domain of an entity, e.g. a domain of a data portal or a field of study of a person."@en ;
    rdfs:subClassOf ns1:IAO_0000030 ;
    skos:editorialNote "2024-03-26: SB & JW: Following the OMIT Ontology, the academy discilpine is defined as a subclass of bfo:quality (see e.g. http://purl.obolibrary.org/obo/OMIT_0001008)"@en,
        "2024-12-16: TT & JW: An academic discipline is not a quality, as assumed before, but an ICE. A discipline like philosophy or chemistry consists of structured knowledge, theories, and practices. These are abstract entities that represent and encode information."@en ;
    skos:example <https://www.wikidata.org/entity/Q12271>,
        "Architecture, Art History, Musicology, Media Studies, Performing Arts"@en ;
    ns4:NFDI_0010013 "https://github.com/ISE-FIZKarlsruhe/nfdicore/issues/80"@en .

ns4:NFDI_0000101 a owl:Class ;
    rdfs:label "service process"@en ;
    rdfs:comment "A process that organizes activities and resources to deliver a specific service, ensuring its efficiency, reliability, and alignment with intended goals."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000015 [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0002234 ;
                        owl:someValuesFrom ns4:NFDI_0000232 ] ) ],
        ns1:BFO_0000015 ;
    ns4:NFDI_0010013 "Issue: https://github.com/ISE-FIZKarlsruhe/nfdicore/issues/75" .

ns4:NFDI_0000131 a owl:Class ;
    rdfs:label "event"@en ;
    rdfs:comment "An process that represents an organized happening that unfolds in time."@en ;
    rdfs:subClassOf ns1:BFO_0000015 ;
    skos:editorialNote "A class that represents entities that occur or unfold in time, typically characterized by a specific organized happening or occurrence with temporal properties."@en ;
    skos:example "conferences, celebrations, workshops, meetings, or any other specific incident or happening that has been planned somehow."@en .

ns4:NFDI_0000244 a owl:Class ;
    rdfs:label "service specification"@en ;
    rdfs:comment "A plan specification that defines the requirements, features, and parameters of a service, outlining its scope, performance, and delivery criteria."@en ;
    rdfs:subClassOf ns1:IAO_0000104 .

ns4:NFDI_0001070 a owl:NamedIndividual ;
    rdfs:label "active status" .

ns4:NFDI_0001092 a owl:NamedIndividual ;
    rdfs:label "self funding" .

