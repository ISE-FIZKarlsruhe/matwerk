<https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174582959914619> a ns4:NFDI_0000232 ;
    ns1:IAO_0000235 <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174611193416712>,
        <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174611211704710>,
