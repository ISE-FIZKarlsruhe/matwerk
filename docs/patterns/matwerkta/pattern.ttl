# matwerkta — ontology design pattern (generated by scripts/gen_patterns.py)
#
# One real row of the 'matwerkta' tab of the MatWerk workbook, with the value node
# nodes it points at resolved. The TBox block declares every term the pattern
# uses: without declarations an OWL parser treats the statements as annotations,
# and a reasoner would call any nonsense consistent.
#
# Ontology version: MWO 3.0.1 (http://purls.helmholtz-metadaten.de/mwo/mwo.owl/3.0.1)

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix nfdi: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix mwo: <http://purls.helmholtz-metadaten.de/mwo/> .
@prefix msekg: <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/> .
@prefix cpa: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# --- Ontology header: this pattern is a versioned artefact ---
<https://nfdi.fiz-karlsruhe.de/matwerk/pattern/matwerkta> a owl:Ontology ;
    owl:versionIRI <https://nfdi.fiz-karlsruhe.de/matwerk/pattern/matwerkta/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ISE-FIZKarlsruhe/mwo/v3.0.1/mwo-full.ttl> ;
    dcterms:conformsTo <http://purls.helmholtz-metadaten.de/mwo/mwo.owl/3.0.1> ;
    rdfs:label "matwerkta — NFDI-MatWerk ontology design pattern" ;
    dcterms:license "CC BY 4.0 (repository); CC0 1.0 declared in the ontology header" ;
    dcterms:bibliographicCitation "Hossein Beygi Nasrabadi, Jörg Waitelonis, Ebrahim Norouzi, Kostiantyn Hubaiev, Harald Sack. NFDI MatWerk Ontology (mwo). Revision: v3.0.1. Retrieved from: http://purls.helmholtz-metadaten.de/mwo/3.0.1" ;
    dcterms:creator <https://orcid.org/0000-0001-7069-9804> ;
    dcterms:creator <https://orcid.org/0000-0001-7192-7143> ;
    dcterms:creator <https://orcid.org/0000-0002-2691-6995> ;
    dcterms:creator <https://orcid.org/0000-0002-3092-0532> ;
    cpa:hasIntent "To represent a objective specification in the MSE Knowledge Graph: its identity, the value nodes that describe it, and its links to the other entities the NFDI-MatWerk consortium records." ;
    cpa:coversRequirements "Which task areas make up NFDI-MatWerk, and what is each responsible for?" ;
    cpa:coversRequirements "Which researchers and organisations contribute to a given task area?" ;
    cpa:coversRequirements "Which infrastructure use cases and participant projects does a task area cover?" ;
    cpa:scenarios "“TA-SD” is a objective specification, with name “Strategy Development”; main goals “Support the digital transformation of materials science through a community-driven process; Monitoring, analysis, feedback of the current state in the community”; description “This TA is responsible for managing the development of a digital strategy for our consortium and the MSE community.”." ;
    cpa:hasUnitTest "SELECT ?x ?label WHERE { ?x a <http://purl.obolibrary.org/obo/IAO_0000005> ; <http://www.w3.org/2000/01/rdf-schema#label> ?label } LIMIT 10" ;
    cpa:hasConsequences "Values become reusable and independently addressable, and one value may be shared by many entities. The cost: every `I` reference resolves by label, so labels must be unique and a typo yields a silently missing relation rather than an error." ;
    cpa:hasComponent nfdi:NFDI_0001035 ;
    cpa:hasComponent obo:BFO_0000015 ;
    cpa:isSpecializationOf <https://nfdi.fiz-karlsruhe.de/matwerk/pattern/entity-and-value-node> ;
    cpa:reengineeredFrom "ROBOT template directives, row 2 of the matwerkta tab" ;
    cpa:extractedFrom "the matwerkta tab of the NFDI-MatWerk curation workbook" .

<https://orcid.org/0000-0001-7069-9804> rdfs:label "Harald Sack" .
<https://orcid.org/0000-0001-7192-7143> rdfs:label "Jörg Waitelonis" .
<https://orcid.org/0000-0002-2691-6995> rdfs:label "Ebrahim Norouzi" .
<https://orcid.org/0000-0002-3092-0532> rdfs:label "Hossein Beygi Nasrabadi" .

# --- the annotation properties used by the header ---
cpa:hasIntent a owl:AnnotationProperty .
cpa:coversRequirements a owl:AnnotationProperty .
cpa:scenarios a owl:AnnotationProperty .
cpa:hasUnitTest a owl:AnnotationProperty .
cpa:extractedFrom a owl:AnnotationProperty .
cpa:hasConsequences a owl:AnnotationProperty .
cpa:hasComponent a owl:AnnotationProperty .
cpa:relatedCPs a owl:AnnotationProperty .
cpa:isSpecializationOf a owl:AnnotationProperty .
cpa:reengineeredFrom a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:conformsTo a owl:AnnotationProperty .
dcterms:bibliographicCitation a owl:AnnotationProperty .

# --- TBox: the terms this pattern uses ---
obo:IAO_0000005 a owl:Class ;
    rdfs:label "objective specification" .
obo:IAO_0000590 a owl:Class ;
    rdfs:label "written name" .
mwo:MWO_0001101 a owl:Class ;
    rdfs:label "measure textual entity" .
nfdi:NFDI_0001018 a owl:Class ;
    rdfs:label "textual description" .
nfdi:NFDI_0001035 a owl:Class ;
    rdfs:label "work package textual entity" .
obo:IAO_0000235 a owl:ObjectProperty ;
    rdfs:label "denoted by" .
nfdi:NFDI_0000226 a owl:ObjectProperty ;
    rdfs:label "is subject of" .

