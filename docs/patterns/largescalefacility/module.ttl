<http://purls.helmholtz-metadaten.de/mwo/mwo.owl> a owl:Ontology .

ns4:coversRequirements a owl:AnnotationProperty .

ns4:extractedFrom a owl:AnnotationProperty .

ns4:hasComponent a owl:AnnotationProperty .

ns4:hasConsequences a owl:AnnotationProperty .

ns4:hasIntent a owl:AnnotationProperty .

ns4:hasUnitTest a owl:AnnotationProperty .

ns4:isSpecializationOf a owl:AnnotationProperty .

ns4:reengineeredFrom a owl:AnnotationProperty .

ns4:relatedCPs a owl:AnnotationProperty .

ns4:scenarios a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

<https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17453262240811> a ns2:NFDI_0001206 ;
    ns1:IAO_0000235 <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17453266100518>,
        <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174532669312511>,
