ns4:NFDI_0000228 a owl:Class ;
    rdfs:label "service product role",
        "service product role"@en ;
    rdfs:comment "Role of an immaterial entity that facilitates the delivery or support of a service product, ensuring its proper execution and value realization."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( ns2:BFO_0000023 [ a owl:Restriction ;
                        owl:onProperty ns2:BFO_0000054 ;
                        owl:someValuesFrom ns4:NFDI_0000101 ] ) ] .

