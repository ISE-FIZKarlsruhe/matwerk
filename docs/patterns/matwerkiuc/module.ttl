<https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454173859641> a ns4:NFDI_0001101 ;
    rdfs:label "teaching personnel can tailor the demo framework as well as datasets and workflows to match their study courses." .

<https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17454174716691> a ns2:IAO_0000642 ;
