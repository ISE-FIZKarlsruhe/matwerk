ns2:IAO_0000118 a owl:AnnotationProperty .

ns2:IAO_0000119 a owl:AnnotationProperty .

ns2:IAO_0000219 a owl:ObjectProperty ;
    rdfs:label "denotes"@en ;
    ns2:IAO_0000112 "A person's name denotes the person. A variable name in a computer program denotes some piece of memory. Lexically equivalent strings can denote different things, for instance \"Alan\" can denote different people. In each case of use, there is a case of the denotation relation obtaining, between \"Alan\" and the person that is being named."@en ;
    ns2:IAO_0000115 "A primitive, instance-level, relation obtaining between an information content entity and some portion of reality. Denotation is what happens when someone creates an information content entity E in order to specifically refer to something. The only relation between E and the thing is that E can be used to 'pick out' the thing. This relation connects those two together. Freedictionary.com sense 3: To signify directly; refer to specifically"@en ;
    ns2:IAO_0000116 """2009-11-10 Alan Ruttenberg. Old definition said the following to emphasize the generic nature of this relation. We no longer have 'specifically denotes', which would have been primitive, so make this relation primitive.
g denotes r =def 
r is a portion of reality
there is some c that is a concretization of g 
every c that is a concretization of g specifically denotes r"""@en ;
    ns2:IAO_0000119 "Conversations with Barry Smith, Werner Ceusters, Bjoern Peters, Michel Dumontier, Melanie Courtot, James Malone, Bill Hogan"@en ;
    rdfs:domain ns2:IAO_0000030 ;
    rdfs:range ns2:BFO_0000001 ;
    rdfs:subPropertyOf ns2:IAO_0000136 ;
    owl:inverseOf ns2:IAO_0000235 .

ns2:RO_0000079 a owl:ObjectProperty ;
    rdfs:label "function of"@en ;
    ns2:IAO_0000112 "this catalysis function is a function of this enzyme"@en ;
    ns2:IAO_0000115 "a relation between a function and an independent continuant (the bearer), in which the function specifically depends on the bearer for its existence"@en ;
    ns2:IAO_0000116 "A function inheres in its bearer at all times for which the function exists, however the function need not be realized at all the times that the function exists."@en ;
    rdfs:domain ns2:BFO_0000034 ;
    rdfs:subPropertyOf ns2:RO_0000052 ;
    owl:inverseOf ns2:RO_0000085 .

ns2:RO_0000080 a owl:ObjectProperty ;
    rdfs:label "quality of"@en ;
    ns2:IAO_0000112 "this red color is a quality of this apple"@en ;
    ns2:IAO_0000115 "a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ;
    ns2:IAO_0000116 "A quality inheres in its bearer at all times for which the quality exists."@en ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( ns2:BFO_0000019 [ a owl:Class ;
                        owl:complementOf ns2:BFO_0000145 ] ) ] ;
    rdfs:subPropertyOf ns2:RO_0000052 ;
    owl:inverseOf ns2:RO_0000086 .

ns2:RO_0000081 a owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    ns2:IAO_0000112 "this investigator role is a role of this person"@en ;
    ns2:IAO_0000115 "a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence"@en ;
    ns2:IAO_0000116 "A role inheres in its bearer at all times for which the role exists, however the role need not be realized at all the times that the role exists."@en ;
    rdfs:subPropertyOf ns2:RO_0000052 ;
    owl:inverseOf ns2:RO_0000087 .

