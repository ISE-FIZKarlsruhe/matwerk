# matwerkpp — ontology design pattern (generated by scripts/gen_patterns.py)
#
# One real row of the 'matwerkpp' tab of the MatWerk workbook, with the value node
# nodes it points at resolved. The TBox block declares every term the pattern
# uses: without declarations an OWL parser treats the statements as annotations,
# and a reasoner would call any nonsense consistent.
#
# Ontology version: MWO 3.0.1 (http://purls.helmholtz-metadaten.de/mwo/mwo.owl/3.0.1)

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix nfdi: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix mwo: <http://purls.helmholtz-metadaten.de/mwo/> .
@prefix msekg: <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/> .
@prefix cpa: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# --- Ontology header: this pattern is a versioned artefact ---
<https://nfdi.fiz-karlsruhe.de/matwerk/pattern/matwerkpp> a owl:Ontology ;
    owl:versionIRI <https://nfdi.fiz-karlsruhe.de/matwerk/pattern/matwerkpp/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ISE-FIZKarlsruhe/mwo/v3.0.1/mwo-full.ttl> ;
    dcterms:conformsTo <http://purls.helmholtz-metadaten.de/mwo/mwo.owl/3.0.1> ;
    rdfs:label "matwerkpp — NFDI-MatWerk ontology design pattern" ;
    dcterms:license "CC BY 4.0 (repository); CC0 1.0 declared in the ontology header" ;
    dcterms:bibliographicCitation "Hossein Beygi Nasrabadi, Jörg Waitelonis, Ebrahim Norouzi, Kostiantyn Hubaiev, Harald Sack. NFDI MatWerk Ontology (mwo). Revision: v3.0.1. Retrieved from: http://purls.helmholtz-metadaten.de/mwo/3.0.1" ;
    dcterms:creator <https://orcid.org/0000-0001-7069-9804> ;
    dcterms:creator <https://orcid.org/0000-0001-7192-7143> ;
    dcterms:creator <https://orcid.org/0000-0002-2691-6995> ;
    dcterms:creator <https://orcid.org/0000-0002-3092-0532> ;
    cpa:hasIntent "To represent a matwerk participant project in the MSE Knowledge Graph: its identity, the value nodes that describe it, and its links to the other entities the NFDI-MatWerk consortium records." ;
    cpa:coversRequirements "Which participant projects are part of NFDI-MatWerk?" ;
    cpa:coversRequirements "Which organisation runs a given participant project, and who leads it?" ;
    cpa:coversRequirements "Which resources has a participant project contributed to the knowledge graph?" ;
    cpa:scenarios "“PP1” is a matwerk participant project, with participant project collabration name “From atoms to turbine blades”; material/methodology description “Ni-based and Co-based single-crystal superalloys, metallic complex solid solutions / experiments and simulations”; engagement statistics “24 Project collabrations in CRC/TRR103, 10 of them on ‘Machine-Learning and Material Informatics‘”." ;
    cpa:hasUnitTest "SELECT ?x ?label WHERE { ?x a <http://purls.helmholtz-metadaten.de/mwo/MWO_0001029> ; <http://www.w3.org/2000/01/rdf-schema#label> ?label } LIMIT 10" ;
    cpa:hasConsequences "Values become reusable and independently addressable, and one value may be shared by many entities. The cost: every `I` reference resolves by label, so labels must be unique and a typo yields a silently missing relation rather than an error." ;
    cpa:isSpecializationOf <https://nfdi.fiz-karlsruhe.de/matwerk/pattern/entity-and-value-node> ;
    cpa:reengineeredFrom "ROBOT template directives, row 2 of the matwerkpp tab" ;
    cpa:extractedFrom "the matwerkpp tab of the NFDI-MatWerk curation workbook" .

<https://orcid.org/0000-0001-7069-9804> rdfs:label "Harald Sack" .
<https://orcid.org/0000-0001-7192-7143> rdfs:label "Jörg Waitelonis" .
<https://orcid.org/0000-0002-2691-6995> rdfs:label "Ebrahim Norouzi" .
<https://orcid.org/0000-0002-3092-0532> rdfs:label "Hossein Beygi Nasrabadi" .

# --- the annotation properties used by the header ---
cpa:hasIntent a owl:AnnotationProperty .
cpa:coversRequirements a owl:AnnotationProperty .
cpa:scenarios a owl:AnnotationProperty .
cpa:hasUnitTest a owl:AnnotationProperty .
cpa:extractedFrom a owl:AnnotationProperty .
cpa:hasConsequences a owl:AnnotationProperty .
cpa:hasComponent a owl:AnnotationProperty .
cpa:relatedCPs a owl:AnnotationProperty .
cpa:isSpecializationOf a owl:AnnotationProperty .
cpa:reengineeredFrom a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:conformsTo a owl:AnnotationProperty .
dcterms:bibliographicCitation a owl:AnnotationProperty .

# --- TBox: the terms this pattern uses ---
obo:IAO_0000005 a owl:Class ;
    rdfs:label "objective specification" .
obo:IAO_0000300 a owl:Class ;
    rdfs:label "textual entity" .
obo:IAO_0000590 a owl:Class ;
    rdfs:label "written name" .
mwo:MWO_0001029 a owl:Class ;
    rdfs:label "matwerk participant project" .
nfdi:NFDI_0001018 a owl:Class ;
    rdfs:label "textual description" .
obo:IAO_0000235 a owl:ObjectProperty ;
    rdfs:label "denoted by" .
obo:RO_0000057 a owl:ObjectProperty ;
    rdfs:label "has participant" .

# --- ABox: one real row from the sheet ---
msekg:17454035079851 a mwo:MWO_0001029 ;
    rdfs:label "PP1" ;
    obo:IAO_0000235 msekg:174541626986223 ;
    obo:IAO_0000235 msekg:174541641250423 ;
    obo:IAO_0000235 msekg:17454178818931 ;
    obo:IAO_0000235 msekg:17454179701921 .

msekg:174541626986223 a obo:IAO_0000590 ;
    rdfs:label "From atoms to turbine blades" .
msekg:174541641250423 a nfdi:NFDI_0001018 ;
    rdfs:label "Ni-based and Co-based single-crystal superalloys, metallic complex solid solutions / experiments and simulations" .
msekg:17454178818931 a obo:IAO_0000300 ;
    rdfs:label "24 Project collabrations in CRC/TRR103, 10 of them on ‘Machine-Learning and Material Informatics‘" .
msekg:17454179701921 a obo:IAO_0000005 ;
    rdfs:label "Focus on alloy design and performance improvement of Ni-based superalloys and Co-based single crystal super alloys with gamma / gamma prime microstructures. Improving processing technology. Obtain knowledge of materials properties and microstructure by implementing new test procedures of mechanical properties and characterization. Scalebridging materials modeling." .
