nfdi:NFDI_0001042 a owl:Class ;
    rdfs:label "zone improvement plan code" .
obo:IAO_0000235 a owl:ObjectProperty ;
    rdfs:label "denoted by" .
obo:RO_0001025 a owl:ObjectProperty ;
    rdfs:label "located in" .
nfdi:NFDI_0000182 a owl:ObjectProperty ;
    rdfs:label "NFDI_0000182" .
nfdi:NFDI_0001006 a owl:ObjectProperty ;
    rdfs:label "NFDI_0001006" .
nfdi:NFDI_0010015 a owl:DatatypeProperty ;
    rdfs:label "has acronym" .

