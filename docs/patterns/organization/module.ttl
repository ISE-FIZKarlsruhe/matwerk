ns1:BFO_0000054 a owl:ObjectProperty ;
    rdfs:label "has realization"@en,
        "realized in"@en ;
    dc:identifier "206-BFO" ;
    rdfs:domain ns1:BFO_0000017 ;
    rdfs:range ns1:BFO_0000015 ;
    owl:inverseOf ns1:BFO_0000055 ;
    skos:altLabel "realized in"@en ;
    skos:definition "b has realization c =Def c realizes b"@en ;
    skos:example "As for realizes"@en .

ns1:IAO_0000112 a owl:AnnotationProperty .

ns1:IAO_0000115 a owl:AnnotationProperty .

ns1:IAO_0000116 a owl:AnnotationProperty .

ns1:IAO_0000118 a owl:AnnotationProperty .

ns1:IAO_0000119 a owl:AnnotationProperty .

ns1:OBI_0001948 a owl:Class ;
    rdfs:label "sequence assembly name"@en ;
    ns1:IAO_0000115 "A textual entity that is used to denote a sequence assembly."@en ;
    ns1:IAO_0000119 "NIAID GSCID-BRC metadata working group" ;
    rdfs:subClassOf ns1:IAO_0000300 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:IAO_0000300 [ a owl:Restriction ;
                        owl:allValuesFrom ns1:SO_0000353 ;
                        owl:onProperty ns1:IAO_0000219 ] ) ] .

ns1:OBI_0002076 a owl:Class ;
    rdfs:label "collection of specimens"@en ;
    ns1:IAO_0000112 "Blood cells collected from multiple donors over the course of a study."@en ;
    ns1:IAO_0000115 "A material entity that has two or more specimens as its parts."@en ;
    ns1:IAO_0000116 "Details see tracker: https://sourceforge.net/p/obi/obi-terms/778/" ;
    ns1:IAO_0000119 "OBIB, OBI" ;
    rdfs:subClassOf ns1:BFO_0000040 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000040 [ a owl:Restriction ;
                        owl:allValuesFrom ns1:OBI_0100051 ;
                        owl:onProperty ns1:RO_0002351 ] ) ] .

ns1:RO_0000079 a owl:ObjectProperty ;
    rdfs:label "function of"@en ;
    ns1:IAO_0000112 "this catalysis function is a function of this enzyme"@en ;
    ns1:IAO_0000115 "a relation between a function and an independent continuant (the bearer), in which the function specifically depends on the bearer for its existence"@en ;
    ns1:IAO_0000116 "A function inheres in its bearer at all times for which the function exists, however the function need not be realized at all the times that the function exists."@en ;
    rdfs:domain ns1:BFO_0000034 ;
    rdfs:subPropertyOf ns1:RO_0000052 ;
    owl:inverseOf ns1:RO_0000085 .

ns1:RO_0000080 a owl:ObjectProperty ;
    rdfs:label "quality of"@en ;
    ns1:IAO_0000112 "this red color is a quality of this apple"@en ;
    ns1:IAO_0000115 "a relation between a quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en ;
    ns1:IAO_0000116 "A quality inheres in its bearer at all times for which the quality exists."@en ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000019 [ a owl:Class ;
                        owl:complementOf ns1:BFO_0000145 ] ) ] ;
    rdfs:subPropertyOf ns1:RO_0000052 ;
    owl:inverseOf ns1:RO_0000086 .

ns1:RO_0002234 a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    ns1:IAO_0000115 "p has output c iff c is a participant in p, c is present at the end of p, and c is not present in the same state at the beginning of p." ;
    rdfs:subPropertyOf ns1:RO_0000057 ;
    owl:inverseOf ns1:RO_0002353 .

ns1:RO_0002350 a owl:ObjectProperty ;
    rdfs:label "member of"@en ;
    ns1:IAO_0000112 "An organism that is a member of a population of organisms" ;
    ns1:IAO_0000115 "is member of is a mereological relation between a item and a collection." ;
    ns1:IAO_0000119 "SIO" ;
    rdfs:subPropertyOf ns1:BFO_0000050 ;
    owl:inverseOf ns1:RO_0002351 .

dc:identifier a owl:AnnotationProperty .

dcterms:bibliographicCitation a owl:AnnotationProperty .

dcterms:conformsTo a owl:AnnotationProperty .

dcterms:creator a owl:AnnotationProperty .

dcterms:license a owl:AnnotationProperty .

<http://purls.helmholtz-metadaten.de/mwo> a owl:Ontology .

<http://purls.helmholtz-metadaten.de/mwo/MWO_0001015> a owl:Class ;
    rdfs:label "object identifier"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000219 ;
            owl:someValuesFrom ns1:BFO_0000030 ],
        ns1:IAO_0020000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:IAO_0020000 [ a owl:Restriction ;
                        owl:onProperty ns1:IAO_0000219 ;
                        owl:someValuesFrom ns1:BFO_0000030 ] ) ] ;
    skos:definition "Object identifier is an identifier that uniquely designates a specific object." .

<http://purls.helmholtz-metadaten.de/mwo/MWO_0001204> a owl:Class ;
    rdfs:label "process identifier"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000219 ;
            owl:someValuesFrom ns1:BFO_0000015 ],
        ns1:IAO_0020000 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:IAO_0020000 [ a owl:Restriction ;
                        owl:onProperty ns1:IAO_0000219 ;
                        owl:someValuesFrom ns1:BFO_0000015 ] ) ] ;
    skos:definition "an identifier that denotes a process and is used to uniquely reference, distinguish, or track that process within a given information system, workflow, or representational context." .

<http://purls.helmholtz-metadaten.de/mwo/MWO_0001220> a owl:Class ;
    rdfs:label "protocol"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:IAO_0000136 ;
            owl:someValuesFrom ns1:BFO_0000015 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:RO_0000058 ;
            owl:someValuesFrom ns1:OBI_0000260 ],
        ns1:IAO_0000104 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:IAO_0000104 [ a owl:Restriction ;
                        owl:onProperty ns1:IAO_0000136 ;
                        owl:someValuesFrom ns1:BFO_0000015 ] [ a owl:Restriction ;
                        owl:onProperty ns1:RO_0000058 ;
                        owl:someValuesFrom ns1:OBI_0000260 ] ) ] ;
    skos:definition "Protocol is a plan specification that prescribes the steps, conditions, rules, or procedures for carrying out a process, experiment, workflow, or activity." .

ns3:coversRequirements a owl:AnnotationProperty .

ns3:extractedFrom a owl:AnnotationProperty .

ns3:hasComponent a owl:AnnotationProperty .

ns3:hasConsequences a owl:AnnotationProperty .

ns3:hasIntent a owl:AnnotationProperty .

ns3:hasUnitTest a owl:AnnotationProperty .

ns3:isSpecializationOf a owl:AnnotationProperty .

ns3:reengineeredFrom a owl:AnnotationProperty .

ns3:relatedCPs a owl:AnnotationProperty .

ns3:scenarios a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:definition a owl:AnnotationProperty .

skos:editorialNote a owl:AnnotationProperty .

skos:example a owl:AnnotationProperty .

skos:scopeNote a owl:AnnotationProperty .

<https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17451394390861> a ns1:OBI_0000245 ;
    rdfs:label "Max Planck Institute for Iron Research",
        "Max-Planck-Institut für Eisenforschung" ;
    ns1:IAO_0000235 <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17451392557111>,
        <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17451392697731>,
        <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17466192215831> ;
    ns1:RO_0001025 <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17451392359571>,
        <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17451393742191> ;
    ns4:NFDI_0000182 <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/174513943908628> ;
    ns4:NFDI_0001006 <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/17451392793301> ;
    ns4:NFDI_0010015 "MPIE" .

<https://nfdi.fiz-karlsruhe.de/matwerk/pattern/organization> a owl:Ontology ;
    rdfs:label "organization — NFDI-MatWerk ontology design pattern" ;
    dcterms:bibliographicCitation "Hossein Beygi Nasrabadi, Jörg Waitelonis, Ebrahim Norouzi, Kostiantyn Hubaiev, Harald Sack. NFDI MatWerk Ontology (mwo). Revision: v3.0.2. Retrieved from: http://purls.helmholtz-metadaten.de/mwo/3.0.2" ;
    dcterms:conformsTo <http://purls.helmholtz-metadaten.de/mwo/mwo.owl/3.0.2> ;
    dcterms:creator <https://orcid.org/0000-0001-7069-9804>,
        <https://orcid.org/0000-0001-7192-7143>,
        <https://orcid.org/0000-0002-2691-6995>,
        <https://orcid.org/0000-0002-3092-0532> ;
    dcterms:license "CC BY 4.0 (repository); CC0 1.0 declared in the ontology header" ;
    ns3:coversRequirements "What is an organisation's ROR identifier, and in which city is it located?",
        "Which organisation is the parent of a given institute?",
        "Which organisations participate in NFDI-MatWerk?",
        "Which researchers, instruments and facilities belong to a given organisation?" ;
    ns3:extractedFrom "the organization tab of the NFDI-MatWerk curation workbook" ;
    ns3:hasComponent ns1:IAO_0000303,
        ns4:NFDI_0000119,
        ns4:NFDI_0001013,
        ns4:NFDI_0001042 ;
    ns3:hasConsequences "Values become reusable and independently addressable, and one value may be shared by many entities. The cost: every `I` reference resolves by label, so labels must be unique and a typo yields a silently missing relation rather than an error." ;
    ns3:hasIntent "To represent a organization in the MatWerk Knowledge Graph: its identity, the value nodes that describe it, and its links to the other entities the NFDI-MatWerk consortium records." ;
    ns3:hasUnitTest "SELECT ?x ?label WHERE { ?x a <http://purl.obolibrary.org/obo/OBI_0000245> ; <http://www.w3.org/2000/01/rdf-schema#label> ?label } LIMIT 10" ;
    ns3:isSpecializationOf <https://nfdi.fiz-karlsruhe.de/matwerk/pattern/entity-and-value-node> ;
    ns3:reengineeredFrom "ROBOT template directives, row 2 of the organization tab" ;
    ns3:scenarios "“Max Planck Institute for Iron Research” is a organization, with institution name “Max Planck Institute for Iron Research_name_”; city “Dusseldorf”; zip code “40237”." ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ISE-FIZKarlsruhe/mwo/v3.0.2/mwo-full.ttl> ;
    owl:versionIRI <https://nfdi.fiz-karlsruhe.de/matwerk/pattern/organization/1.0.0> ;
    owl:versionInfo "1.0.0" .

ns4:NFDI_0000182 a owl:ObjectProperty ;
    rdfs:label "NFDI_0000182" .

ns4:NFDI_0001006 a owl:ObjectProperty ;
    rdfs:label "NFDI_0001006" .

ns4:NFDI_0010013 a owl:AnnotationProperty .

ns4:NFDI_0010015 a owl:AnnotationProperty,
        owl:DatatypeProperty ;
    rdfs:label "has acronym",
        "has acronym"@en ;
    skos:definition "A relation between an entity and its abbreviated form, representing a shortened version of the original term or phrase." .

<https://w3id.org/pmd/co/PMD_0000833> a owl:Class ;
    rdfs:label "Herstellungsprozess"@de,
        "manufacturing process"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:BFO_0000027 ns1:BFO_0000030 ) ] ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( ns1:BFO_0000027 ns1:BFO_0000030 ) ] ],
        ns1:COB_0000035 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:COB_0000035 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000293 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:BFO_0000027 ns1:BFO_0000030 ) ] ] [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000299 ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( ns1:BFO_0000027 ns1:BFO_0000030 ) ] ] ) ] ;
    skos:definition "Ein geplannter Prozess, der von der primären Absicht angetrieben wird, Objekte zu transformieren. Ein Herstellungsprozess ist immer ein Transformationsprozess."@de,
        """A planned process that is driven by the primary intent to transform objects
A manufacturing process is always a transformative process."""@en .

ns1:BFO_0000140 a owl:Class ;
    rdfs:label "continuant fiat boundary"@en ;
    dc:identifier "029-BFO" ;
    rdfs:subClassOf ns1:BFO_0000141 ;
    skos:definition "(Elucidation) A continuant fiat boundary b is an immaterial entity that is of zero, one or two dimensions & such that there is no time t when b has a spatial region as continuant part & whose location is determined in relation to some material entity"@en ;
    skos:example "As for fiat point, fiat line, fiat surface"@en .

ns1:BFO_0000145 a owl:Class ;
    rdfs:label "relational quality"@en ;
    dc:identifier "057-BFO" ;
    rdfs:subClassOf ns1:BFO_0000019 ;
    skos:definition "b is a relational quality =Def b is a quality & there exists c and d such that c and d are not identical & b specifically depends on c & b specifically depends on d"@en ;
    skos:example "A marriage bond; an instance of love; an obligation between one person and another"@en .

ns1:COB_0000082 a owl:Class ;
    rdfs:label "planned process"@en ;
    ns1:IAO_0000115 "A process that is initiated by an agent who intends to carry out a plan to achieve an objective through one or more actions as described in a plan specification."@en ;
    rdfs:subClassOf ns1:BFO_0000015 .

ns1:IAO_0000007 a owl:Class ;
    rdfs:label "action specification"@en ;
    ns1:IAO_0000112 "Pour the contents of flask 1 into flask 2"@en ;
    ns1:IAO_0000115 "A directive information entity that describes an action the bearer will take."@en ;
    ns1:IAO_0000119 "OBI Plan and Planned Process branch"@en ;
    rdfs:subClassOf ns1:IAO_0000033 .

ns1:IAO_0000028 a owl:Class ;
    rdfs:label "symbol"@en ;
    ns1:IAO_0000112 "a serial number such as \"12324X\""@en,
        "a stop sign"@en,
        "a written proper name such as \"OBI\""@en ;
    ns1:IAO_0000115 "An information content entity that is a mark(s) or character(s) used as a conventional representation of another entity."@en ;
    ns1:IAO_0000116 "20091104, MC: this needs work and will most probably change"@en,
        "2014-03-31: We would like to have a deeper analysis of 'mark' and 'sign' in the future (see https://github.com/information-artifact-ontology/IAO/issues/154)."@en ;
    ns1:IAO_0000119 "based on Oxford English Dictionary"@en ;
    rdfs:subClassOf ns1:IAO_0000030 .

ns1:IAO_0000235 a owl:ObjectProperty ;
    rdfs:label "denoted by",
        "denoted by"@en ;
    ns1:IAO_0000115 "inverse of the relation 'denotes'"@en ;
    rdfs:domain ns1:BFO_0000001 ;
    rdfs:range ns1:IAO_0000030 ;
    rdfs:subPropertyOf ns4:NFDI_0000226 .

ns1:IAO_0000577 a owl:Class ;
    rdfs:label "centrally registered identifier symbol"@en ;
    ns1:IAO_0000112 "The sentence \"The article has Pubmed ID 12345.\" contains a CRID that has two parts: one part is the CRID symbol, which is '12345'; the other part denotes the CRID registry, which is Pubmed."@en ;
    ns1:IAO_0000115 "A symbol that is part of a CRID and that is sufficient to look up a record from the CRID's registry."@en ;
    ns1:IAO_0000118 "CRID symbol" ;
    ns1:IAO_0000119 "Original proposal from Bjoern, discussions at IAO calls"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000050 ;
            owl:someValuesFrom ns1:IAO_0000578 ],
        ns1:IAO_0000028 .

ns1:IAO_0000579 a owl:Class ;
    rdfs:label "centrally registered identifier registry"@en ;
    ns1:IAO_0000112 "PubMed is a CRID registry. It has a code set of PubMed identifiers associated with journal articles. "@en ;
    ns1:IAO_0000115 "A code set of CRID records, each consisting of a CRID symbol and additional information which was recorded in the code set through an assigning a centrally registered identifier process."@en ;
    ns1:IAO_0000118 "CRID registry" ;
    ns1:IAO_0000119 "Original proposal from Bjoern, discussions at IAO calls"@en ;
    rdfs:subClassOf ns1:IAO_0020020 .

ns1:IAO_0020020 a owl:Class ;
    rdfs:label "code set"@en ;
    ns1:IAO_0000115 "An information content entity that is a collection of other information content entities that has been created to identify or annotate things in a specified domain, and where the intention of its creators is that the collection has a one-to-one correspondence with those things."@en ;
    ns1:IAO_0000118 "code map"@en,
        "code system"@en,
        "codeset"@en,
        "coding system"@en,
        "controlled vocabulary"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:BFO_0000051 ;
            owl:someValuesFrom ns1:IAO_0020000 ],
        ns1:IAO_0000030 .

ns1:OBI_0000295 a owl:ObjectProperty ;
    rdfs:label "is specified input of"@en ;
    ns1:IAO_0000112 "some Autologous EBV(Epstein-Barr virus)-transformed B-LCL (B lymphocyte cell line) is_input_for instance of Chromum Release Assay described at https://wiki.cbil.upenn.edu/obiwiki/index.php/Chromium_Release_assay"@en ;
    ns1:IAO_0000115 "A relation between a completely executed planned process and a continuant participating in that process that is not created during the process. The presence of the continuant during the process is explicitly specified in the plan specification which the process realizes the concretization of." ;
    rdfs:range ns1:COB_0000035 ;
    rdfs:subPropertyOf ns1:RO_0000056 .

ns1:OBI_0000659 a owl:Class ;
    rdfs:label "specimen collection process" ;
    ns1:IAO_0000112 "drawing blood from a patient for analysis, collecting a piece of a plant for depositing in a herbarium, buying meat from a butcher in order to measure its protein content in an investigation, collecting a stone from a site" ;
    ns1:IAO_0000115 "A planned process with the objective to obtain a material entity for potential use as an input upon which measurements or observations are performed."@en ;
    ns1:IAO_0000116 "Definition updated following discussion on 2024-10-07 OBI dev call.",
        "Note: definition is in specimen creation objective which is defined as an objective to obtain and store a material entity for potential use as an input during an investigation.",
        "Philly2013: A specimen collection can have as part a material entity acquisition, such as ordering from a bank. The distinction is that specimen collection necessarily involves the creation of a specimen role. However ordering cell lines cells from ATCC for use in an investigation is NOT a specimen collection, because the cell lines already have a specimen role.",
        "Philly2013: The specimen_role for the specimen is created during the specimen collection process.",
        """label  changed to 'specimen collection process' on 10/27/2014, details see tracker:
http://sourceforge.net/p/obi/obi-terms/716/""" ;
    ns1:IAO_0000118 "specimen collection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000293 ;
            owl:someValuesFrom ns1:BFO_0000040 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000299 ;
            owl:someValuesFrom ns1:OBI_0100051 ],
        [ a owl:Restriction ;
            owl:onProperty ns1:OBI_0000417 ;
            owl:someValuesFrom ns1:OBI_0000684 ],
        ns1:COB_0000035 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( ns1:COB_0000035 [ a owl:Restriction ;
                        owl:onProperty ns1:OBI_0000417 ;
                        owl:someValuesFrom ns1:OBI_0000684 ] ) ] .

ns1:OBI_0000833 a owl:ObjectProperty ;
    rdfs:label "objective_achieved_by" ;
    ns1:IAO_0000115 "This relation obtains between an objective specification and a planned process when the criteria specified in the objective specification are met at the end of the planned process."@en ;
    ns1:IAO_0000119 "OBI" ;
    rdfs:domain ns1:IAO_0000005 ;
    rdfs:range ns1:COB_0000035 .

ns1:RO_0000081 a owl:ObjectProperty ;
    rdfs:label "role of"@en ;
    ns1:IAO_0000112 "this investigator role is a role of this person"@en ;
    ns1:IAO_0000115 "a relation between a role and an independent continuant (the bearer), in which the role specifically depends on the bearer for its existence"@en ;
    ns1:IAO_0000116 "A role inheres in its bearer at all times for which the role exists, however the role need not be realized at all the times that the role exists."@en ;
    rdfs:subPropertyOf ns1:RO_0000052 ;
    owl:inverseOf ns1:RO_0000087 .

ns1:RO_0000091 a owl:ObjectProperty ;
    rdfs:label "has disposition"@en ;
    ns1:IAO_0000115 "a relation between an independent continuant (the bearer) and a disposition, in which the disposition specifically depends on the bearer for its existence"@en ;
    rdfs:domain ns1:BFO_0000004 ;
    rdfs:range ns1:BFO_0000016 ;
    rdfs:subPropertyOf ns1:RO_0000053 ;
    owl:inverseOf ns1:RO_0000092 .

ns1:RO_0000092 a owl:ObjectProperty ;
    rdfs:label "disposition of"@en ;
    ns1:IAO_0000115 "inverse of has disposition" ;
    rdfs:subPropertyOf ns1:RO_0000052 .

ns1:RO_0001025 a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "located in",
        "located in"@en ;
    ns1:IAO_0000112 "my brain is located in my head"@en,
        "this rat is located in this cage"@en ;
    ns1:IAO_0000115 "a relation between two independent continuants, the target and the location, in which the target is entirely within the location"@en ;
    ns1:IAO_0000116 "Location as a relation between instances: The primitive instance-level relation c located_in r at t reflects the fact that each continuant is at any given time associated with exactly one spatial region, namely its exact location. Following we can use this relation to define a further instance-level location relation - not between a continuant and the region which it exactly occupies, but rather between one continuant and another. c is located in c1, in this sense, whenever the spatial region occupied by c is part_of the spatial region occupied by c1.    Note that this relation comprehends both the relation of exact location between one continuant and another which obtains when r and r1 are identical (for example, when a portion of fluid exactly fills a cavity), as well as those sorts of inexact location relations which obtain, for example, between brain and head or between ovum and uterus"@en,
        "Most location relations will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ;
    rdfs:domain [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000004 [ a owl:Class ;
                        owl:complementOf ns1:BFO_0000006 ] ) ],
        ns1:BFO_0000004 ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( ns1:BFO_0000004 [ a owl:Class ;
                        owl:complementOf ns1:BFO_0000006 ] ) ],
        ns1:BFO_0000004 ;
    owl:propertyChainAxiom ( ns1:RO_0001025 ns1:BFO_0000050 ) .

ns1:SO_0000001 a owl:Class ;
    rdfs:label "region" ;
    ns1:IAO_0000115 "A sequence_feature with an extent greater than zero. A nucleotide region is composed of bases and a polypeptide region is composed of amino acids." ;
    ns1:IAO_0000118 "primary structure of sequence macromolecule",
        "sequence" ;
    rdfs:subClassOf ns1:BFO_0000040 .

ns1:SO_0000353 a owl:Class ;
    rdfs:label "sequence_assembly" ;
    ns1:IAO_0000115 "A sequence of nucleotides that has been algorithmically derived from an alignment of two or more different sequences." ;
    rdfs:subClassOf ns1:SO_0001248 .

ns1:SO_0001248 a owl:Class ;
    rdfs:label "assembly" ;
    ns1:IAO_0000115 "A region of the genome of known length that is composed by ordering and aligning two or more different regions." ;
    rdfs:subClassOf ns1:SO_0001410 .

ns1:SO_0001410 a owl:Class ;
    rdfs:label "experimental_feature" ;
