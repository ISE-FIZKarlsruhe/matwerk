# ontologies — ontology design pattern (generated by scripts/gen_patterns.py)
#
# One real row of the 'ontologies' tab of the MatWerk workbook, with the value node
# nodes it points at resolved. The TBox block declares every term the pattern
# uses: without declarations an OWL parser treats the statements as annotations,
# and a reasoner would call any nonsense consistent.
#
# Ontology version: MWO 3.0.1 (http://purls.helmholtz-metadaten.de/mwo/mwo.owl/3.0.1)

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix nfdi: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix mwo: <http://purls.helmholtz-metadaten.de/mwo/> .
@prefix msekg: <https://nfdi.fiz-karlsruhe.de/matwerk/msekg/> .
@prefix cpa: <http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# --- Ontology header: this pattern is a versioned artefact ---
<https://nfdi.fiz-karlsruhe.de/matwerk/pattern/ontologies> a owl:Ontology ;
    owl:versionIRI <https://nfdi.fiz-karlsruhe.de/matwerk/pattern/ontologies/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    rdfs:isDefinedBy <https://raw.githubusercontent.com/ISE-FIZKarlsruhe/mwo/v3.0.1/mwo-full.ttl> ;
    dcterms:conformsTo <http://purls.helmholtz-metadaten.de/mwo/mwo.owl/3.0.1> ;
    rdfs:label "ontologies — NFDI-MatWerk ontology design pattern" ;
    dcterms:license "CC BY 4.0 (repository); CC0 1.0 declared in the ontology header" ;
    dcterms:bibliographicCitation "Hossein Beygi Nasrabadi, Jörg Waitelonis, Ebrahim Norouzi, Kostiantyn Hubaiev, Harald Sack. NFDI MatWerk Ontology (mwo). Revision: v3.0.1. Retrieved from: http://purls.helmholtz-metadaten.de/mwo/3.0.1" ;
    dcterms:creator <https://orcid.org/0000-0001-7069-9804> ;
    dcterms:creator <https://orcid.org/0000-0001-7192-7143> ;
    dcterms:creator <https://orcid.org/0000-0002-2691-6995> ;
    dcterms:creator <https://orcid.org/0000-0002-3092-0532> ;
    cpa:hasIntent "To represent a ontology in the MSE Knowledge Graph: its identity, the value nodes that describe it, and its links to the other entities the NFDI-MatWerk consortium records." ;
    cpa:coversRequirements "Which ontologies are used or developed in NFDI-MatWerk?" ;
    cpa:coversRequirements "What is the version and licence of a given ontology, and where is it published?" ;
    cpa:coversRequirements "Which ontology is reused by a given metadata standard or knowledge graph?" ;
    cpa:scenarios "“Dislocation Ontology (DISO)” is a ontology, with name “Dislocation Ontology (DISO)”; link (url / pid) to repository “url 570”; link (url / pid) to documentation “url 666”." ;
    cpa:hasUnitTest "SELECT ?x ?label WHERE { ?x a <https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000023> ; <http://purl.obolibrary.org/obo/IAO_0000235> ?d . ?d <http://www.w3.org/2000/01/rdf-schema#label> ?label } LIMIT 10" ;
    cpa:hasConsequences "Values become reusable and independently addressable, and one value may be shared by many entities. The cost: every `I` reference resolves by label, so labels must be unique and a typo yields a silently missing relation rather than an error." ;
    cpa:hasComponent obo:IAO_0000590 ;
    cpa:hasComponent nfdi:NFDI_0000030 ;
    cpa:isSpecializationOf <https://nfdi.fiz-karlsruhe.de/matwerk/pattern/entity-and-value-node> ;
    cpa:reengineeredFrom "ROBOT template directives, row 2 of the ontologies tab" ;
    cpa:extractedFrom "the ontologies tab of the NFDI-MatWerk curation workbook" .

<https://orcid.org/0000-0001-7069-9804> rdfs:label "Harald Sack" .
<https://orcid.org/0000-0001-7192-7143> rdfs:label "Jörg Waitelonis" .
<https://orcid.org/0000-0002-2691-6995> rdfs:label "Ebrahim Norouzi" .
<https://orcid.org/0000-0002-3092-0532> rdfs:label "Hossein Beygi Nasrabadi" .

# --- the annotation properties used by the header ---
cpa:hasIntent a owl:AnnotationProperty .
cpa:coversRequirements a owl:AnnotationProperty .
cpa:scenarios a owl:AnnotationProperty .
cpa:hasUnitTest a owl:AnnotationProperty .
cpa:extractedFrom a owl:AnnotationProperty .
cpa:hasConsequences a owl:AnnotationProperty .
cpa:hasComponent a owl:AnnotationProperty .
cpa:relatedCPs a owl:AnnotationProperty .
cpa:isSpecializationOf a owl:AnnotationProperty .
cpa:reengineeredFrom a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:conformsTo a owl:AnnotationProperty .
dcterms:bibliographicCitation a owl:AnnotationProperty .

# --- TBox: the terms this pattern uses ---
obo:IAO_0000590 a owl:Class ;
    rdfs:label "written name" .
<http://www.ebi.ac.uk/swo/SWO_0000002> a owl:Class ;
    rdfs:label "licence" .
nfdi:NFDI_0000022 a owl:Class ;
    rdfs:label "document" .
nfdi:NFDI_0000023 a owl:Class ;
    rdfs:label "ontology" .
nfdi:NFDI_0000030 a owl:Class ;
    rdfs:label "source code repository" .
nfdi:NFDI_0001018 a owl:Class ;
    rdfs:label "textual description" .
obo:IAO_0000235 a owl:ObjectProperty ;
    rdfs:label "denoted by" .
nfdi:NFDI_0000142 a owl:ObjectProperty ;
    rdfs:label "NFDI_0000142" .

# --- ABox: one real row from the sheet ---
msekg:17453296469553 a nfdi:NFDI_0000023 ;
    obo:IAO_0000235 msekg:174532987657423 ;
    obo:IAO_0000235 msekg:17453306512862 ;
    obo:IAO_0000235 msekg:17453307829846 ;
    obo:IAO_0000235 msekg:174533026528323 ;
    nfdi:NFDI_0000142 msekg:174516196088818 .

msekg:174532987657423 a obo:IAO_0000590 ;
    rdfs:label "Dislocation Ontology (DISO)" .
msekg:17453306512862 a nfdi:NFDI_0000030 ;
    rdfs:label "url 570" .
msekg:17453307829846 a nfdi:NFDI_0000022 ;
    rdfs:label "url 666" .
msekg:174533026528323 a nfdi:NFDI_0001018 ;
    rdfs:label "DISO is a domain ontology that defines the linear defect, in particular dislocation concepts and relations between them in crystalline materials. Moreover, Crystal Structure Ontology (CSO) and Crystallographic Defect Ontology (CDO), which ontologies define the concepts of crystal structureand crystalline defect, respectively, are also introduced in this repository." .
msekg:174516196088818 a <http://www.ebi.ac.uk/swo/SWO_0000002> ;
    rdfs:label "MIT" .
